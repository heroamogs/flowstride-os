{
  "name": "flowstride",
  "version": "1.0.18",
  "description": "An opensource flowfirst test automation framework",
  "workspaces": [
    "packages/flowstride_report"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/ui/dist"
  ],
  "bin": {
    "flowstride": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "flowstride": "node ./dist/cli/index.js",
    "test": "echo 'Test script to be configured'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "automation",
    "testing",
    "qa",
    "flowstride"
  ],
  "author": "Samuel Okolo",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "axios": "^1.18.0",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "dotenv": "^17.4.2",
    "open": "^11.0.0",
    "ora": "^5.4.1",
    "playwright": "^1.59.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tar": "^7.5.16",
    "ts-node": "^10.9.2",
    "undici": "^7.25.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^0.15.1"
  }
}
