{
  "name": "flowstride",
  "version": "1.0.20",
  "description": "An opensource flowfirst test automation framework",
  "workspaces": [
    "packages/flowstride_report"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/ui/dist",
    "NATIVE_CI.md",
    "examples/native-game",
    "NATIVE_BROWSER.md"
  ],
  "bin": {
    "flowstride": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "flowstride": "node ./dist/cli/index.js",
    "test": "npm run test:native && npm run test:manual-security && npm run test:dashboard",
    "prepublishOnly": "npm run build:candidate && npm run verify:candidate",
    "test:native": "node --test --test-concurrency=1 tests/native/*.test.cjs",
    "test:manual-security": "node --test tests/manual-security.test.cjs",
    "build:candidate": "node scripts/build-candidate.cjs",
    "verify:candidate": "node scripts/verify-candidate.cjs",
    "test:dashboard:unit": "node --test tests/dashboard/store.test.cjs",
    "test:dashboard": "node --test --test-concurrency=1 tests/dashboard/*.test.cjs",
    "test:unit": "node --test tests/native/core.test.cjs tests/native/combined.test.cjs tests/native/curl.test.cjs tests/native/upload.test.cjs tests/dashboard/store.test.cjs tests/native/replay.test.cjs tests/dashboard/replay.test.cjs tests/native/assertions-sessions.test.cjs tests/native/capabilities.test.cjs tests/native/browser-selection.unit.test.cjs",
    "test:security": "node --test tests/manual-security.test.cjs tests/native/curl.test.cjs tests/native/combined.test.cjs tests/native/replay.test.cjs tests/native/assertions-sessions.test.cjs tests/native/capabilities.test.cjs tests/native/browser-selection.unit.test.cjs",
    "test:replay": "node --test tests/native/replay.test.cjs tests/dashboard/replay.test.cjs tests/dashboard/curl.browser.test.cjs",
    "test:assertions-sessions": "node --test --test-concurrency=1 tests/native/assertions-sessions*.test.cjs",
    "test:capabilities": "node --test --test-concurrency=1 tests/native/capabilities*.test.cjs"
  },
  "keywords": [
    "automation",
    "testing",
    "qa",
    "flowstride"
  ],
  "author": "Samuel Okolo",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@inquirer/prompts": "^7.10.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-vue": "6.0.10",
    "axios": "^1.20.0",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "dom-accessibility-api": "0.7.1",
    "dotenv": "^17.4.2",
    "open": "^11.0.0",
    "ora": "^5.4.1",
    "playwright": "1.59.1",
    "playwright-core": "1.59.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sanitize-html": "2.18.1",
    "tar": "^7.5.22",
    "ts-node": "^10.9.2",
    "undici": "^7.30.1",
    "vite": "8.3.5",
    "ws": "^8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/sanitize-html": "2.16.2",
    "@types/ws": "^8.18.1",
    "three": "0.186.1",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^0.15.1"
  },
  "publishConfig": {
    "tag": "latest"
  }
}
